{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Resource Allocation Planner",
  "version": "0.1.0",
  "identifier": "com.chis.resource-allocation-planner",
  "build": {
    "beforeDevCommand": "vite dev",
    "devUrl": "http://localhost:5402",
    "beforeBuildCommand": "vite build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Планировщик распределения ресурсов",
        "width": 1100,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "ru-RU"
      }
    }
  }
}
