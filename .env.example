# Copy to `.env.local` and fill with `supabase status -o env` (local) or project keys (remote).
# Never commit real secrets.

PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_ANON_KEY=

# Server-only / scripts (not exposed to the browser bundle)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Used by `pnpm seed:users` (Auth Admin API). Do not commit real passwords.
SEED_PASSWORD=

# Password for pnpm seed:users (admin@rap.local, demo1@rap.local, demo2@rap.local)
# Leave empty to use script default "password123"
SEED_PASSWORD=
