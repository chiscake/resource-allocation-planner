# Copy to `.env.local` (web / `pnpm dev`), `.env.tauri` (`tauri:dev` / `tauri:build`),
# or `.env.cloud` (RAP cloud) and fill keys. Never commit real secrets.
#
# Which file Vite loads:
#   - under Tauri CLI: `.env.tauri` if present, else `vite.env-file` / `.env.local`
#   - web: edit `vite.env-file`, or one-shot `RAP_ENV_FILE=.env.cloud pnpm dev`
#   - always: `RAP_ENV_FILE=...` overrides everything
#
# Cloud: after `supabase link --project-ref ktdxdqnhjitolfpcztds`, use RAP URL + publishable + service_role.
# Client canon: PUBLIC_SUPABASE_PUBLISHABLE_KEY (not ANON_KEY).

PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only / scripts (not exposed to the browser bundle)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Used by `pnpm seed:users` (Auth Admin API). Do not commit real passwords.
SEED_PASSWORD=

# Bottom quick-login bar under /app (seed accounts). true/1/yes/on; false to force off.
# Unset: enabled automatically in Vite `pnpm dev`.
PUBLIC_DEV_QUICK_LOGIN=true

# Show DLN in method tabs and method comparison. UI only — solve endpoints still accept dln.
# true/1/yes/on to show; unset or false/0/no/off → hidden.
PUBLIC_SHOW_DLN=false

# Show organizations functionality in the UI.
PUBLIC_SHOW_ORGS=false
