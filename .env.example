# Copy to `.env.local` (local Supabase) or `.env.cloud` (RAP cloud) and fill keys.
# Never commit real secrets.
#
# Which file Vite loads: edit `vite.env-file` (path), or one-shot:
#   RAP_ENV_FILE=.env.cloud pnpm dev
#
# Cloud: after `supabase link --project-ref ktdxdqnhjitolfpcztds`, use RAP URL + publishable + service_role.
# Client canon: PUBLIC_SUPABASE_PUBLISHABLE_KEY (not ANON_KEY).

PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only / scripts (not exposed to the browser bundle)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Used by `pnpm seed:users` (Auth Admin API). Do not commit real passwords.
SEED_PASSWORD=
